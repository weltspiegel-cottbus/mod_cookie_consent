<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_COOKIE_CONSENT</name>
    <version>0.1.5</version>
    <creationDate>16.12.2025</creationDate>
    <author>Michael Buchholz</author>
    <authorEmail>mail@lean-stack.rocks</authorEmail>
    <copyright>Weltspiegel Cottbus</copyright>
    <license>MIT</license>
    <description>MOD_COOKIE_CONSENT_XML_DESCRIPTION</description>

    <files>
        <filename module="mod_cookie_consent">mod_cookie_consent.php</filename>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>

    <media folder="media" destination="mod_cookie_consent">
        <folder>css</folder>
        <folder>js</folder>
        <filename>joomla.asset.json</filename>
    </media>

    <languages folder="language">
        <language tag="de-DE">de-DE/mod_cookie_consent.ini</language>
        <language tag="de-DE">de-DE/mod_cookie_consent.sys.ini</language>
        <language tag="en-GB">en-GB/mod_cookie_consent.ini</language>
        <language tag="en-GB">en-GB/mod_cookie_consent.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="consent_text"
                    type="textarea"
                    label="Consent Text"
                    description="Text displayed in the consent banner"
                    rows="3"
                    cols="50"
                    default="Diese Seite nutzt selbst keine Cookies zur Nutzer-Verfolgung. Falls du allerdings YouTube Trailer dir eingebettet anschauen willst, musst du diese explizit freischalten. Damit erlaubst du aber ein Tracking seitens YouTube."
                />

                <field
                    name="button_ok"
                    type="text"
                    label="OK Button Text"
                    description="Label des Schließen-Buttons (übernimmt nichts, schließt nur)"
                    default="OK"
                />

                <field
                    name="drawer_text"
                    type="text"
                    label="Drawer Text"
                    description="Text shown in the drawer tab"
                    default="Cookie-Einstellungen"
                />

                <field
                    name="categories"
                    type="subform"
                    label="Consent-Kategorien"
                    description="Verwaltbare Zustimmungs-Kategorien. Jede erscheint als eigener Schalter im Banner. Leer = Standardkategorie 'youtube'."
                    multiple="true"
                    layout="joomla.form.field.subform.repeatable-table"
                >
                    <form>
                        <field
                            name="cat_id"
                            type="text"
                            label="ID"
                            description="Technische ID, z.B. youtube (wird im localStorage und von Feature-Skripten genutzt)"
                        />
                        <field
                            name="cat_label"
                            type="text"
                            label="Label"
                            description="Anzeigename des Schalters"
                        />
                        <field
                            name="cat_description"
                            type="textarea"
                            label="Beschreibung"
                            description="Kurze Erklärung unter dem Label"
                            rows="2"
                        />
                        <field
                            name="cat_default"
                            type="radio"
                            layout="joomla.form.field.radio.switcher"
                            label="Standardmäßig erlaubt"
                            default="0"
                        >
                            <option value="0">Nein</option>
                            <option value="1">Ja</option>
                        </field>
                    </form>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
